# Frontend variables (safe to expose only anon/public keys)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_PUBLIC_SITE_URL=http://localhost:5173

# SERVER ONLY — configure in Cloudflare Pages settings, never in VITE_ variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
MERCADO_PAGO_ACCESS_TOKEN=TEST-YOUR_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
PUBLIC_SITE_URL=https://YOUR_SITE.pages.dev
